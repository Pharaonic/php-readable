{
  "name": "pharaonic/php-readable",
  "description": "Framework-agnostic, human-friendly formatting for PHP: numbers, bytes, money, durations, plus small array and string inspection helpers.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "php",
    "readable",
    "human readable",
    "number format",
    "file size",
    "bytes",
    "money",
    "currency",
    "duration",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "homepage": "https://github.com/Pharaonic/php-readable",
  "support": {
    "docs": "https://pharaonic.dev/packages/php/readable",
    "issues": "https://github.com/Pharaonic/php-readable/issues",
    "source": "https://github.com/Pharaonic/php-readable",
    "security": "https://github.com/Pharaonic/php-readable/security/policy"
  },
  "require": {
    "php": ">=8.5 <8.6",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "pestphp/pest": "^4.0 || ^5.0",
    "phpstan/phpstan": "^2.1.33"
  },
  "suggest": {
    "ext-intl": "Required only when passing a $locale to the Number, Money and Bytes formatters."
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Readable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Readable\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
